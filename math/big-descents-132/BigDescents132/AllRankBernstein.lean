private theorem radical_positive {a b s w : ℝ} (hs : 0<s) (sq : s^2=w)
    (h : (0<a ∧ 0≤b) ∨ (0<a ∧ 0<a^2-w*b^2) ∨ (0<b ∧ a^2-w*b^2<0)) :
    0<a+b*s := by
  have v : (b*s)^2=w*b^2 := by rw [mul_pow,sq]; ring
  rcases h with ⟨x,y⟩|⟨x,y⟩|⟨x,y⟩
  · exact add_pos_of_pos_of_nonneg x (mul_nonneg y hs.le)
  · by_contra! z
    have l : a≤ -(b*s) := by linarith
    nlinarith only [v,y,pow_le_pow_left₀ x.le l 2]
  · by_contra! z
    have l : b*s≤ -a := by linarith
    nlinarith only [v,y,pow_le_pow_left₀ (mul_pos x hs).le l 2]

private theorem gap_numerator_0 {p v : ℝ} (lo : 0≤p) (hi : p≤1)
    (hs : 0<v) (sq : v^2=-3*p^4 + 6*p^2 + 1) : 0 < (18*(p + 1)^2 - (2*p + v)*(4*v + 8)) := by
  have hx : 0≤p-0 := sub_nonneg.mpr lo
  have hy : 0≤1-p := sub_nonneg.mpr hi
  have ha : (0:ℝ)<(p*(p*(12*p^2 - 6) + 20) + 14) := by
    calc
      0 < 7 +
        7*(1-p)^4 +
        48*(p-0)^1*(1-p)^3 +
        96*(p-0)^2*(1-p)^2 +
        76*(p-0)^3*(1-p)^1 +
        33*(p-0)^4 := by positivity
      _ = _ := by ring
  have ht : (0:ℝ)<(p*(p*(p*(p*(p*(p*(144*p^2 + 48) + 864) + 180) - 1008) - 216) + 432) + 132) := by
    calc
      0 < (396/7) +
        (528/7)*(1-p)^8 +
        (7248/7)*(p-0)^1*(1-p)^7 +
        4920*(p-0)^2*(1-p)^6 +
        10992*(p-0)^3*(1-p)^5 +
        12300*(p-0)^4*(1-p)^4 +
        6528*(p-0)^5*(1-p)^3 +
        1584*(p-0)^6*(1-p)^2 +
        (4896/7)*(p-0)^7*(1-p)^1 +
        (3636/7)*(p-0)^8 := by positivity
      _ = _ := by ring
  have red : 18*(p + 1)^2 - (2*p + v)*(4*v + 8)=(p*(p*(12*p^2 - 6) + 20) + 14)+(-8*p - 8)*v := by linear_combination (-4)*sq
  rw [red]
  have id : (p*(p*(12*p^2 - 6) + 20) + 14)^2-(-3*p^4 + 6*p^2 + 1)*(-8*p - 8)^2=(p*(p*(p*(p*(p*(p*(144*p^2 + 48) + 864) + 180) - 1008) - 216) + 432) + 132) := by ring
  exact radical_positive hs sq (Or.inr (Or.inl ⟨ha,by rw [id]; exact ht⟩))

theorem gap_numerator {p v : ℝ} (hp : p∈Icc 0 1)
    (hs : 0<v) (sq : v^2=-3*p^4 + 6*p^2 + 1) : 0 < (18*(p + 1)^2 - (2*p + v)*(4*v + 8)) := by
  exact gap_numerator_0 (by linarith [hp.1]) hp.2 hs sq

