def BigDescents132.EventualSimpleNegative : Prop :=
∃ N,
  ∀ n ≥ N,
    (BigDescents132.B n).natDegree = BigDescents132.expectedDegree n ∧
      BigDescents132.SimpleNegative (BigDescents132.B n)
BigDescents132.A_recurrence (k : ℕ) :
  BigDescents132.A (k + 2) = BigDescents132.A (k + 1) + Polynomial.X * BigDescents132.C (k + 1)
BigDescents132.C_recurrence (k : ℕ) :
  BigDescents132.C (k + 2) =
    BigDescents132.B (k + 1) + Polynomial.X * ∑ i ∈ Finset.range k, BigDescents132.B (i + 1) * BigDescents132.B (k - i)
BigDescents132.B_eq_row_through52 (n : ℕ) (hn : n ≤ 52) :
  BigDescents132.B n = BigDescents132.ofRow (BigDescents132.Certificate52.table n).total
BigDescents132.finite52_simple_negative (n : ℕ) (hn : n ≤ 52) :
  (BigDescents132.B n).natDegree = BigDescents132.expectedDegree n ∧ BigDescents132.SimpleNegative (BigDescents132.B n)
BigDescents132.finite_simple_negative (n : ℕ) (hn : n ≤ 10) :
  (BigDescents132.B n).natDegree = BigDescents132.expectedDegree n ∧ BigDescents132.SimpleNegative (BigDescents132.B n)
BigDescents132.eventual_of_phase_certificates
  (h :
    ∃ N, ∀ n ≥ N, Nonempty (BigDescents132.PhaseCertificate (BigDescents132.B n) (BigDescents132.expectedDegree n))) :
  BigDescents132.EventualSimpleNegative
