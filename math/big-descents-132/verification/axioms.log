BigDescents132.Series.cauchy_coefficient (t : ℝ) :
  ∃ r,
    0 < r ∧
      ∀ (n : ℕ),
        ↑(Polynomial.eval t (BigDescents132.B (n + 1))) =
          (2 * ↑Real.pi * Complex.I)⁻¹ *
            ∮ (z : ℂ) in C(0, r), z⁻¹ ^ (n + 1) * BigDescents132.Branch.regularBranch (1 - ↑t) z
