BigDescents132.small_endpoint_limit (u : ℝ) :
  Filter.Tendsto (fun n => Polynomial.eval (u / ↑n ^ 3) (BigDescents132.B n) / ↑n) Filter.atTop
    (nhds (BigDescents132.smallLimit u))
BigDescents132.Series.far_endpoint_limit (e : Fin 3) (y : ℝ) :
  Filter.Tendsto
    (fun p =>
      let n := 3 * p + 2 * ↑e + 1;
      let d := 2 * p + ↑e;
      Polynomial.eval (y / ↑n ^ 3) (BigDescents132.B n).reverse / (BigDescents132.B n).coeff d)
    Filter.atTop (nhds (BigDescents132.Far.farLimit (↑e) y))
BigDescents132.eventually_many_negative_roots (K : ℕ) (T : ℝ) :
  ∀ᶠ (n : ℕ) in Filter.atTop, ∃ s, s.card = K ∧ ∀ x ∈ s, x < T ∧ x < 0 ∧ (BigDescents132.B n).IsRoot x
BigDescents132.Cut.moving_complex_cut_bound {n : ℕ} (hn : 8 ≤ n) {h K : ℝ} (hh : 0 < h) (hK : 0 ≤ K) (hm : 7 ≤ ↑n * h)
  (U : ℝ → ℂ) (hU : ContinuousOn U (Set.Ioi 0))
  (pointwise : ∀ v ∈ Set.Ioi 0, ‖U v - 1‖ ≤ K * (v / h) * (1 + v / h) ^ 2) :
  ‖(∫ (v : ℝ) in Set.Ioi 0, BigDescents132.Cut.kernel n v • U v) - ↑(BigDescents132.Cut.moment n 0)‖ /
      BigDescents132.Cut.moment n 0 ≤
    28 * K / (↑n * h)
