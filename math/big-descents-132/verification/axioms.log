BigDescents132.Cut.moving_cut_cosine {n : ℕ} (hn : 8 ≤ n) {h E K D c θ b T : ℝ} (hE : 0 < E) (hEh : E ≤ h) (hK : 0 ≤ K)
  (hD : 0 ≤ D) (hc : 0 < c) (hu : 7 ≤ ↑n * E) (q : ℂ) (hq : ‖q‖ = 1) (hphase : q.re = Real.cos θ) (U V : ℝ → ℂ)
  (hU : ContinuousOn U (Set.Ioi 0)) (complexBound : ∀ v ∈ Set.Ioi 0, ‖U v - 1‖ ≤ K * (v / h) * (1 + v / h) ^ 2)
  (realBound :
    (h = E ∧ ∀ v ∈ Set.Ioo 0 T, ‖V v‖ ≤ K * (h / v) * (1 + v / h) ^ 2) ∨ ∀ v ∈ Set.Ioo 0 T, ‖V v‖ ≤ K * (1 + v / h) ^ 2)
  (damping : |b| ≤ D * Real.exp (-(c * (↑n * E)))) :
  |BigDescents132.Cut.normalizedCuts n q b T U V - Real.cos θ| ≤ (28 * K + 6 * D * K / c ^ 2) / (↑n * E)
